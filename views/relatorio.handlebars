<div class="row justify-content-center">
  <div class="col-md-10">
    <h1 class="mb-4"><i class="bi bi-bar-chart text-warning"></i> Relatório de Habilidades</h1>

    <div class="card shadow mb-4">
      <div class="card-body">
        <p class="lead">
          Proporção de alunos que possuem cada habilidade e a média de nível.
          <span class="badge bg-dark">Total de alunos: {{totalAlunos}}</span>
        </p>
      </div>
    </div>

    {{#if erro}}
      <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> {{erro}}</div>
    {{/if}}

    {{#if dados.length}}
      <div class="table-responsive">
        <table class="table table-striped table-hover">
          <thead class="table-dark">
            <tr>
              <th>Habilidade</th>
              <th>Alunos com a Habilidade</th>
              <th>Proporção</th>
              <th>Média de Nível</th>
              <th>Visualização</th>
            </tr>
          </thead>
          <tbody>
            {{#each dados}}
              <tr>
                <td><strong>{{this.nome}}</strong></td>
                <td>
                  <span class="badge bg-info text-dark">{{this.totalAlunos}}</span>
                </td>
                <td>{{this.proporcao}}%</td>
                <td>
                  <span class="badge bg-warning text-dark">{{this.mediaNivel}} / 10</span>
                </td>
                <td style="width: 200px;">
                  <div class="progress" style="height: 25px;">
                    <div class="progress-bar bg-warning" role="progressbar"
                         style="width: {{this.proporcao}}%">
                      {{this.proporcao}}%
                    </div>
                  </div>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Nenhum dado disponível para o relatório.
      </div>
    {{/if}}

    <a href="/" class="btn btn-secondary mt-3">
      <i class="bi bi-arrow-left"></i> Voltar ao Início
    </a>
  </div>
</div>
