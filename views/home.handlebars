<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><i class="bi bi-egg-fried text-warning"></i> Receitas Culinárias</h1>
</div>

<!-- Filtro por categoria -->
<div class="card mb-4">
  <div class="card-body">
    <form action="/receitas/filtrar" method="GET" class="row g-3 align-items-end">
      <div class="col-md-8">
        <label for="categoria_id" class="form-label">
          <i class="bi bi-funnel"></i> Filtrar por Categoria
        </label>
        <select class="form-select" id="categoria_id" name="categoria_id">
          <option value="">Todas as categorias</option>
          {{#each categorias}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.nome}}</option>
          {{/each}}
        </select>
      </div>
      <div class="col-md-4">
        <button type="submit" class="btn btn-dark w-100">
          <i class="bi bi-search"></i> Filtrar
        </button>
      </div>
    </form>
  </div>
</div>

{{#if erro}}
  <div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> {{erro}}
  </div>
{{/if}}

{{#if receitas.length}}
  <div class="row">
    {{#each receitas}}
      <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title">
              <i class="bi bi-journal-richtext text-warning"></i> {{this.nome}}
            </h5>
            <p class="card-text text-muted flex-grow-1">
              {{#if this.descricao}}
                {{this.descricao}}
              {{else}}
                <em>Sem descrição</em>
              {{/if}}
            </p>

            <!-- Categorias -->
            {{#if this.categorias.length}}
              <div class="mb-2">
                {{#each this.categorias}}
                  <span class="badge bg-secondary me-1">{{this.nome}}</span>
                {{/each}}
              </div>
            {{/if}}

            <!-- Responsáveis -->
            {{#if this.responsaveis.length}}
              <div class="mb-2">
                <small class="text-muted">
                  <i class="bi bi-people"></i>
                  {{#each this.responsaveis}}
                    <span class="badge bg-info text-dark me-1">{{this.login}}</span>
                  {{/each}}
                </small>
              </div>
            {{/if}}
          </div>
          <div class="card-footer bg-transparent">
            <a href="/receitas/detalhes/{{this.id}}" class="btn btn-outline-dark btn-sm">
              <i class="bi bi-eye"></i> Ver Detalhes
            </a>
            {{#if this.link_externo}}
              <a href="{{this.link_externo}}" target="_blank" class="btn btn-outline-warning btn-sm">
                <i class="bi bi-link-45deg"></i> Link Externo
              </a>
            {{/if}}
          </div>
        </div>
      </div>
    {{/each}}
  </div>
{{else}}
  <div class="alert alert-info">
    <i class="bi bi-info-circle"></i> Nenhuma receita encontrada.
    {{#if filtroAtivo}}
      <a href="/" class="alert-link">Limpar filtro</a>
    {{/if}}
  </div>
{{/if}}
