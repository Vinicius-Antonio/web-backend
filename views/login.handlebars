<div class="row w-100 justify-content-center align-items-center m-0" style="min-height: 100vh; background-color: #f5ede8;">
  <div class="col-12 col-md-6 col-lg-4 p-3">
    <div class="card shadow-sm" style="border: 1px solid #ddd0c8; border-radius: 12px; overflow: hidden;">
      
      <div style="background-color: #6E3A2C; padding: 2rem 1.5rem; text-align: center;">
        <i class="bi bi-cup-hot" style="font-size: 2.5rem; color: #fdf8f5;"></i>
        <h3 class="mt-3 mb-0" style="color: #fdf8f5; font-family: Georgia, serif; font-weight: normal;">Receitas UTFPR</h3>
      </div>

      <div class="card-body p-4 p-md-5" style="background-color: #ffffff;">
        {{#if erro}}
          <div class="alert alert-danger p-2" role="alert" style="border-radius: 6px; font-size: 0.9rem;">
            <i class="bi bi-exclamation-circle me-1"></i> {{erro}}
          </div>
        {{/if}}

        <form action="/login" method="POST">
          <div class="mb-4">
            <label for="login" class="form-label" style="color: #2a1a14; font-size: 0.9rem; font-weight: 500;">Login</label>
            <input type="text" class="form-control form-control-lg" id="login" name="login" required autofocus
                   style="border-radius: 6px; font-size: 1rem; border-color: #ddd0c8;">
          </div>
          
          <div class="mb-4">
            <label for="senha" class="form-label" style="color: #2a1a14; font-size: 0.9rem; font-weight: 500;">Senha</label>
            <input type="password" class="form-control form-control-lg" id="senha" name="senha" required
                   style="border-radius: 6px; font-size: 1rem; border-color: #ddd0c8;">
          </div>

          <button type="submit" class="btn btn-lg w-100 mt-2" 
                  style="background-color: #954534; color: #fff; border: none; border-radius: 6px; font-size: 1rem;">
            Entrar
          </button>
        </form>

        <div class="text-center mt-4">
          <a href="/" class="text-decoration-none" style="color: #8e8079; font-size: 0.9rem;">
            &larr; Voltar para a página inicial
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .form-control:focus {
    border-color: #996851 !important;
    box-shadow: 0 0 0 3px rgba(153, 104, 81, 0.1) !important;
  }
  .btn:hover {
    background-color: #6E3A2C !important;
  }
</style>
