<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Portfólio Web de Receitas Culinárias - UTFPR">
  <title>Receitas Culinárias - UTFPR</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .navbar-brand i {
      color: #fd7e14;
    }
    main {
      flex: 1;
    }
    footer {
      background-color: #343a40;
      color: #adb5bd;
      padding: 1rem 0;
      margin-top: auto;
    }
    .card {
      transition: transform 0.2s;
    }
    .card:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">
        <i class="bi bi-egg-fried"></i> Receitas UTFPR
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav me-auto">
          <!-- Links públicos -->
          <li class="nav-item">
            <a class="nav-link" href="/"><i class="bi bi-house"></i> Início</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/relatorio"><i class="bi bi-bar-chart"></i> Relatório</a>
          </li>

          {{#if logado}}
            <!-- Links do aluno logado -->
            <li class="nav-item">
              <a class="nav-link" href="/receitas/minhas"><i class="bi bi-journal-text"></i> Minhas Receitas</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/receitas/cadastrar"><i class="bi bi-plus-circle"></i> Nova Receita</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/habilidades/minhas"><i class="bi bi-star"></i> Minhas Habilidades</a>
            </li>
          {{/if}}

          {{#if admin}}
            <!-- Links do admin -->
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                <i class="bi bi-gear"></i> Administração
              </a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/alunos"><i class="bi bi-people"></i> Alunos</a></li>
                <li><a class="dropdown-item" href="/categorias"><i class="bi bi-tags"></i> Categorias</a></li>
                <li><a class="dropdown-item" href="/habilidades"><i class="bi bi-lightning"></i> Habilidades</a></li>
              </ul>
            </li>
          {{/if}}
        </ul>

        <ul class="navbar-nav">
          {{#if logado}}
            <li class="nav-item">
              <span class="nav-link text-light">
                <i class="bi bi-person-circle"></i> {{loginUsuario}}
                {{#if admin}}<span class="badge bg-warning text-dark ms-1">Admin</span>{{/if}}
              </span>
            </li>
            <li class="nav-item">
              <a class="nav-link text-danger" href="/logout"><i class="bi bi-box-arrow-right"></i> Sair</a>
            </li>
          {{else}}
            <li class="nav-item">
              <a class="nav-link" href="/login"><i class="bi bi-box-arrow-in-right"></i> Entrar</a>
            </li>
          {{/if}}
        </ul>
      </div>
    </div>
  </nav>

  <!-- Conteúdo principal -->
  <main class="container py-4">
    {{{body}}}
  </main>

  <!-- Footer -->
  <footer class="text-center">
    <div class="container">
      <p class="mb-0">&copy; 2026 - Portfólio de Receitas Culinárias | UTFPR - Programação Web Back-End</p>
    </div>
  </footer>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
