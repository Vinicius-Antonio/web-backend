<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card shadow">
      <div class="card-header bg-dark text-white">
        <h3 class="mb-0"><i class="bi bi-plus-circle"></i> Nova Receita</h3>
      </div>
      <div class="card-body">
        <form action="/receitas/cadastrar" method="POST">
          <div class="mb-3">
            <label for="nome" class="form-label">Nome da Receita *</label>
            <input type="text" class="form-control" id="nome" name="nome" required placeholder="Ex: Bolo de Chocolate">
          </div>

          <div class="mb-3">
            <label for="descricao" class="form-label">Descrição</label>
            <textarea class="form-control" id="descricao" name="descricao" rows="4"
                      placeholder="Descreva a receita..."></textarea>
          </div>

          <div class="mb-3">
            <label for="link_externo" class="form-label">Link Externo</label>
            <input type="url" class="form-control" id="link_externo" name="link_externo"
                   placeholder="https://exemplo.com/receita">
          </div>

          <div class="mb-3">
            <label class="form-label">Categorias</label>
            <div class="row">
              {{#each categorias}}
                <div class="col-md-4 mb-2">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="categorias"
                           value="{{this.id}}" id="cat_{{this.id}}">
                    <label class="form-check-label" for="cat_{{this.id}}">{{this.nome}}</label>
                  </div>
                </div>
              {{/each}}
            </div>
            {{#unless categorias.length}}
              <p class="text-muted"><em>Nenhuma categoria cadastrada.</em></p>
            {{/unless}}
          </div>

          <div class="mb-3">
            <label class="form-label">Outros Responsáveis</label>
            <select class="form-select" name="responsaveis" multiple size="4">
              {{#each alunos}}
                <option value="{{this.id}}">{{this.login}}</option>
              {{/each}}
            </select>
            <div class="form-text">Segure Ctrl para selecionar múltiplos. Você já será adicionado automaticamente.</div>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning">
              <i class="bi bi-check-lg"></i> Cadastrar
            </button>
            <a href="/receitas/minhas" class="btn btn-secondary">
              <i class="bi bi-arrow-left"></i> Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
