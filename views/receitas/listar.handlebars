<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>
    <i class="bi bi-journal-text text-warning"></i>
    {{#if minhas}}Minhas Receitas{{else}}Receitas{{/if}}
  </h1>
  {{#if logado}}
    <a href="/receitas/cadastrar" class="btn btn-warning">
      <i class="bi bi-plus-circle"></i> Nova Receita
    </a>
  {{/if}}
</div>

{{#if erro}}
  <div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> {{erro}}
  </div>
{{/if}}

{{#if receitas.length}}
  <div class="table-responsive">
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>#</th>
          <th>Nome</th>
          <th>Descrição</th>
          <th>Categorias</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each receitas}}
          <tr>
            <td>{{this.id}}</td>
            <td><strong>{{this.nome}}</strong></td>
            <td>
              {{#if this.descricao}}
                {{this.descricao}}
              {{else}}
                <em class="text-muted">Sem descrição</em>
              {{/if}}
            </td>
            <td>
              {{#each this.categorias}}
                <span class="badge bg-secondary">{{this.nome}}</span>
              {{/each}}
            </td>
            <td>
              <a href="/receitas/detalhes/{{this.id}}" class="btn btn-outline-dark btn-sm" title="Detalhes">
                <i class="bi bi-eye"></i>
              </a>
              <a href="/receitas/editar/{{this.id}}" class="btn btn-outline-primary btn-sm" title="Editar">
                <i class="bi bi-pencil"></i>
              </a>
              <a href="/receitas/excluir/{{this.id}}" class="btn btn-outline-danger btn-sm" title="Excluir"
                 onclick="return confirm('Tem certeza que deseja excluir esta receita?')">
                <i class="bi bi-trash"></i>
              </a>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
{{else}}
  <div class="alert alert-info">
    <i class="bi bi-info-circle"></i> Nenhuma receita encontrada.
    {{#if logado}}
      <a href="/receitas/cadastrar" class="alert-link">Cadastre sua primeira receita!</a>
    {{/if}}
  </div>
{{/if}}
