<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card shadow">
      <div class="card-header bg-dark text-white">
        <h3 class="mb-0"><i class="bi bi-chat-left-text"></i> Novo Comentário</h3>
      </div>
      <div class="card-body">
        <p class="text-muted mb-3">
          Receita: <strong>{{receitaNome}}</strong>
        </p>

        <form action="/comentarioCreate" method="POST">
          <input type="hidden" name="receitaId" value="{{receitaId}}">

          <div class="mb-3">
            <label for="autor" class="form-label">Autor *</label>
            <input type="text" class="form-control" id="autor" name="autor"
                   value="{{autor}}" required placeholder="Seu nome" {{#if autor}}readonly{{/if}}>
          </div>

          <div class="mb-3">
            <label for="titulo" class="form-label">Título *</label>
            <input type="text" class="form-control" id="titulo" name="titulo"
                   required placeholder="Título do comentário">
          </div>

          <div class="mb-3">
            <label for="texto" class="form-label">Comentário *</label>
            <textarea class="form-control" id="texto" name="texto" rows="4"
                      required placeholder="Escreva seu comentário..."></textarea>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning">
              <i class="bi bi-check-lg"></i> Enviar Comentário
            </button>
            <a href="/comentarioList/{{receitaId}}" class="btn btn-secondary">
              <i class="bi bi-arrow-left"></i> Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
