<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow">
      <div class="card-header bg-dark text-white">
        <h3 class="mb-0"><i class="bi bi-pencil"></i> Editar Habilidade</h3>
      </div>
      <div class="card-body">
        <form action="/habilidades/editar/{{habilidade.id}}" method="POST">
          <div class="mb-3">
            <label for="nome" class="form-label">Nome da Habilidade *</label>
            <input type="text" class="form-control" id="nome" name="nome"
                   value="{{habilidade.nome}}" required>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check-lg"></i> Salvar
            </button>
            <a href="/habilidades" class="btn btn-secondary">
              <i class="bi bi-arrow-left"></i> Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
