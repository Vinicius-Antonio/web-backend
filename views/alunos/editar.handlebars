<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow">
      <div class="card-header bg-dark text-white">
        <h3 class="mb-0"><i class="bi bi-pencil"></i> Editar Aluno</h3>
      </div>
      <div class="card-body">
        <form action="/alunos/editar/{{aluno.id}}" method="POST">
          <div class="mb-3">
            <label for="login" class="form-label">Login *</label>
            <input type="text" class="form-control" id="login" name="login"
                   value="{{aluno.login}}" required>
          </div>

          <div class="mb-3">
            <label for="senha" class="form-label">Nova Senha</label>
            <input type="password" class="form-control" id="senha" name="senha"
                   placeholder="Deixe em branco para manter a atual">
          </div>

          <div class="mb-3">
            <label for="tipo" class="form-label">Tipo *</label>
            <select class="form-select" id="tipo" name="tipo" required>
              <option value="1" {{#if (eq aluno.tipo 1)}}selected{{/if}}>Aluno Comum</option>
              <option value="2" {{#if (eq aluno.tipo 2)}}selected{{/if}}>Administrador</option>
            </select>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check-lg"></i> Salvar
            </button>
            <a href="/alunos" class="btn btn-secondary">
              <i class="bi bi-arrow-left"></i> Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
